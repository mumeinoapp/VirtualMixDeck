{
  "name": "virtualmixdeck",
  "version": "0.0.1",
  "description": "Stream Deck風ショートカット + アプリ別ローカル/配信音量ミキサー + OBS連携デスクトップアプリ「VirtualMixDeck」",
  "author": "yato",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "clean:release": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "prebuild": "npm run clean:release",
    "build": "electron-builder",
    "prebuild:win": "npm run clean:release",
    "build:win": "electron-builder --win",
    "prerelease": "npm run clean:release",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@raphiiko/wavelink-ts": "^2.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "obs-websocket-js": "^5.0.6"
  },
  "build": {
    "appId": "com.mumeinoapp.virtualmixdeck",
    "productName": "VirtualMixDeck",
    "copyright": "Copyright © 2026 yato",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "../helper/bin/Release/net10.0-windows/win-x64/publish/VirtualMixDeck.Helper.exe",
        "to": "helper/VirtualMixDeck.Helper.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mumeinoapp",
      "repo": "VirtualMixDeck"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
